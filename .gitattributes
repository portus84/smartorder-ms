# =========================
# Normalize line endings
# =========================
# Automatically detect text files, force LF endings
* text=auto eol=lf

# =========================
# Source code and configuration files
# =========================
*.java        text eol=lf
*.xml         text eol=lf
*.properties  text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.gradle      text eol=lf
*.md          text eol=lf
*.txt         text eol=lf
*.json        text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.js          text eol=lf

# =========================
# Binary files (do not attempt text conversion)
# =========================
*.jar         binary
*.war         binary
*.ear         binary
*.class       binary
*.zip         binary
*.tar         binary
*.gz          binary
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.ico         binary
*.dll         binary
*.exe         binary

# =========================
# IDE and project files (optional)
# =========================
*.iml         text eol=lf
*.idea/*      text eol=lf
*.classpath   text eol=lf
*.project     text eol=lf
*.settings/*  text eol=lf

# =========================
# Lock files
# =========================
*.lock        binary
